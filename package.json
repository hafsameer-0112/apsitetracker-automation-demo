{
  "name": "apsitetracker-automation-demo",
  "version": "1.0.0",
  "description": "Playwright automation demo using TypeScript",
  "private": true,
  "scripts": {
    "test": "playwright test tests/adding-and-moving-sites.spec.ts",
    "test:headed": "playwright test tests/adding-and-moving-sites.spec.ts --headed",
    "test:debug": "playwright test tests/adding-and-moving-sites.spec.ts --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install --with-deps",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "e2e",
    "testing"
  ],
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "dotenv": "^16.4.5"
  }
}
